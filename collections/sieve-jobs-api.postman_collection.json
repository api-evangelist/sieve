          "request": {
            "name": "Push New Job",
            "description": {
              "content": "Creates a new job by running a function. Specify the function with `function` (author/name[:version]) or `id` - one or the other, not both - and pass the function's parameters in `inputs`. Optionally register `webhooks` to be notified on job events.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "push"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inputs\": {\n    \"key_0\": 2678.5509056067467,\n    \"key_1\": true,\n    \"key_2\": 9511,\n    \"key_3\": \"string\"\n  },\n  \"function\": \"<string>\",\n  \"id\": \"<string>\",\n  \"webhooks\": [\n    {\n      \"type\": \"<string>\",\n      \"url\": \"<string>\"\n    },\n    {\n      \"type\": \"<string>\",\n      \"url\": \"<string>\"\n    }\n  ],\n  \"env\": {\n    \"key_0\": true\n  }\n}",
